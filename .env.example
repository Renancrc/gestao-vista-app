# Modelo de configuração. Copie para .env e ajuste:
#   cp .env.example .env
# O .env está no .gitignore e NUNCA vai para o GitHub.

ENVIRONMENT=local

# Banco PostgreSQL (o compose cria o banco com estes dados)
POSTGRES_DB=gestao
POSTGRES_USER=gestao
POSTGRES_PASSWORD=troque-esta-senha

# URLs usadas pela API e pelo worker. "postgres" e "redis" são os nomes
# dos serviços no docker-compose.yml (a rede interna do Docker resolve esses nomes)
DATABASE_URL=postgresql+psycopg://gestao:troque-esta-senha@postgres:5432/gestao
REDIS_URL=redis://redis:6379/0
